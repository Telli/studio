{
  "machine": {"kind": "mill", "axes": 3, "post": "linuxcnc", "max_rpm": 10000, "max_feed_mm_min": 2500, "rapid_mm_min": 5000},
  "material": "aluminum-6061",
  "stock": {"type": "box", "margin_mm": [2, 2, 1, 5]},
  "setups": [
    {"id": "top", "direction": "+Z", "origin": "stock_top_center",
     "fixture": {"type": "vise", "jaw_height_mm": 40, "grip_mm": 4}},
    {"id": "bottom", "direction": "-Z", "origin": "stock_top_center",
     "fixture": {"type": "vise", "jaw_height_mm": 40, "grip_mm": 6}}
  ],
  "tools": [
    {"id": "T1", "type": "flat_endmill", "diameter_mm": 6, "flutes": 3, "flute_length_mm": 13, "stickout_mm": 20, "comment": "3FL carbide, aluminium"},
    {"id": "T2", "type": "flat_endmill", "diameter_mm": 4, "flutes": 2, "flute_length_mm": 11, "stickout_mm": 16, "comment": "2FL carbide, aluminium"},
    {"id": "T3", "type": "spot_drill", "diameter_mm": 6, "tip_angle_deg": 90, "material": "hss"},
    {"id": "T4", "type": "drill", "diameter_mm": 2.5, "flute_length_mm": 30, "stickout_mm": 36, "material": "hss", "comment": "M3 tap drill"},
    {"id": "T5", "type": "drill", "diameter_mm": 3.4, "flute_length_mm": 39, "stickout_mm": 45, "material": "hss"},
    {"id": "T6", "type": "tap", "diameter_mm": 3, "pitch_mm": 0.5, "flute_length_mm": 10, "stickout_mm": 30, "material": "hss", "comment": "M3x0.5 spiral point, floating holder"},
    {"id": "T7", "type": "chamfer_mill", "diameter_mm": 6, "tip_angle_deg": 90, "comment": "90 deg carbide"}
  ],
  "operations": [
    {"op": "facing", "setup": "top", "tool": "T1", "coolant": "flood"},
    {"op": "contour_2d", "setup": "top", "tool": "T1", "features": ["#o1.1.f1"], "stepdown_mm": 1.5, "breakthrough_mm": 0.3, "coolant": "flood"},
    {"op": "bore", "setup": "top", "tool": "T2", "features": ["#o1.1.f10"], "coolant": "flood"},
    {"op": "spot_drill", "setup": "top", "tool": "T3", "features": ["#o1.1.f5", "#o1.1.f6", "#o1.1.f8", "#o1.1.f9", "#o1.1.f13"], "coolant": "flood"},
    {"op": "drill", "setup": "top", "tool": "T4", "features": ["#o1.1.f5", "#o1.1.f6", "#o1.1.f8", "#o1.1.f9"], "cycle": "peck", "coolant": "flood"},
    {"op": "drill", "setup": "top", "tool": "T5", "features": ["#o1.1.f13"], "coolant": "flood"},
    {"op": "tap", "setup": "top", "tool": "T6", "features": ["#o1.1.f5", "#o1.1.f6", "#o1.1.f8", "#o1.1.f9"], "rpm": 600, "coolant": "flood"},
    {"op": "chamfer_2d", "setup": "top", "tool": "T7", "features": ["#o1.1.f1"], "coolant": "flood"},
    {"op": "facing", "setup": "bottom", "tool": "T1", "coolant": "flood"}
  ]
}
